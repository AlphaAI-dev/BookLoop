# BookLoop environment variables — TEMPLATE ONLY.
#
# Copy to `.env.local` for local development and fill in real values there.
# On Replit, add the same names under Secrets. Never commit real values.
#
# Variables prefixed with NEXT_PUBLIC_ are embedded in the browser bundle.
# NEVER give a secret a NEXT_PUBLIC_ prefix.

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (required from BL-002) ---------------------------------------
# Dashboard → Project Settings → API. For the local stack use
# http://127.0.0.1:54321 and the anon key printed by `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Public key: the legacy "anon" JWT or the new "sb_publishable_..." key.
# The app refuses to start a client if this is a service-role/secret key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# Server only. Bypasses Row Level Security — never import in client code.
# Not used by the app yet (first needed for webhooks/admin workflows).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase CLI (database owner machine only; never needed by the app):
#   SUPABASE_ACCESS_TOKEN — for `supabase login` / `link` / `db push`
#   SUPABASE_DB_PASSWORD  — remote database password for `supabase link`

# --- Razorpay (test mode only until provider approval) ---------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# Server only.
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Server only. Used to verify webhook signatures against the raw body.
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# --- AI (optional, P1) ------------------------------------------------------
# Server only. Provider not yet selected.
AI_PROVIDER_API_KEY=
